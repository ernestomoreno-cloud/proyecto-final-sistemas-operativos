{
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (backend_instance)",
          "legendFormat": "{{backend_instance}}",
          "refId": "A"
        }
      ],
      "title": "Tasa de Solicitudes Backend (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, backend_instance)) * 1000",
          "legendFormat": "P95 - {{backend_instance}}",
          "refId": "A"
        }
      ],
      "title": "Latencia P95 Backend (ms)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Conexiones Activas",
          "refId": "A"
        },
        {
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "Solicitudes Nginx (req/s)",
          "refId": "B"
        }
      ],
      "title": "Rendimiento Nginx",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\"}[1m])) by (id) * 100",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "title": "Uso de CPU por Contenedor (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id=~\"/docker/.+\"} / 1024 / 1024",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "title": "Memoria RAM por Contenedor (MB)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "KBs"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{id=\"/\", interface!=\"lo\"}[1m])) by (interface) / 1024",
          "legendFormat": "RX - {{interface}}",
          "refId": "A"
        }
      ],
      "title": "Trafico de Red Recibido (KB/s)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Monitoreo Infraestructura Docker - UAO",
  "uid": "uao-so-dashboard",
  "version": 1
}